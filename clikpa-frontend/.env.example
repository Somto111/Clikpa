# REST API base URL (relative path recommended when behind a proxy, or full backend URL)
VITE_API_BASE_URL=/api

# Set to "true" to use the built-in stateful mock adapter (src/api/mock.js)
VITE_USE_MOCK=true

# Sign-in mode: "code" (one-time email code) or "password" (email + password)
VITE_AUTH_MODE=code
